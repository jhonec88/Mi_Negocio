PORT=3000
NODE_ENV=development

# Base de datos: Compatible con Local Docker o Supabase / Cloud
# Para Supabase, solo descomentas DATABASE_URL y pegas tu URI:
# DATABASE_URL=postgresql://postgres.xxxx:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Conexión local por variables separadas (Fallback por defecto)
DB_HOST=localhost
DB_PORT=5432
DB_USER=tecnofix_admin
DB_PASSWORD=tecnofix_secure_pass_2026
DB_NAME=tecnofix_db

# Seguridad JWT / Supabase Auth
# Al configurar Supabase Auth, coloca tus credenciales (Project Settings -> API en Supabase):
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui
JWT_EXPIRES_IN=7d

# Configuración Comercial Inicial
DEFAULT_ADMIN_EMAIL=admin@tecnofix.com.co
DEFAULT_ADMIN_PASSWORD=AdminTecnoFix2026*
DEFAULT_ADMIN_NAME=Administrador TecnoFix
WHATSAPP_PHONE=573001234567
BUSINESS_NAME=TecnoFix Colombia
